# Polsia — environment template.  `cp .env.example .env` is step 1 of the README quick start,
# and four services in docker-compose.yml declare `env_file: .env`, so this file is required
# for the documented stack to start at all.
#
# Every variable here maps 1:1 to a field in backend/app/config.py (pydantic-settings matches
# the lower-cased name) — except the POSTGRES_* trio below, which docker-compose reads for the
# postgres container and Settings ignores (extra="ignore").  Empty means "integration disabled" —
# the product stays usable, and any code path that needs the missing credential returns a NAMED
# refusal instead of pretending.

# ── app ───────────────────────────────────────────────────────────────────────
APP_NAME=Polsia
ENVIRONMENT=development
# FastAPI(debug=...) in app/main.py — verbose error payloads for development only
DEBUG=false
LOG_LEVEL=INFO
# true = one JSON object per log record (stdlib formatter in app/main.py); false = plain text
LOG_JSON=false
# config.py: cors_origins: list[str] = ["http://localhost", "http://localhost:3000"]
# (complex types are parsed as JSON by pydantic-settings)
CORS_ORIGINS=["http://localhost", "http://localhost:3000"]

# ── auth ──────────────────────────────────────────────────────────────────────
# The dashboard sends this as X-API-Key.  CHANGE IT before exposing the API.
API_KEY=dev-key

# ── database ──────────────────────────────────────────────────────────────────
# Production (docker-compose injects this for the backend/worker/beat services):
DATABASE_URL=postgresql+asyncpg://polsia:polsia_password@postgres:5432/polsia
# Local, no Postgres required (the unit suite uses this):
# DATABASE_URL=sqlite+aiosqlite:///./polsia.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
# Postgres container credentials (docker-compose reads these too; they are not Settings fields)
POSTGRES_USER=polsia
POSTGRES_PASSWORD=polsia_password
POSTGRES_DB=polsia

# ── redis / celery ────────────────────────────────────────────────────────────
# COMPOSE-NETWORK hostnames: REDIS_URL / CELERY_* here (and DATABASE_URL above) point at `redis` /
# `postgres`, which resolve only inside docker-compose — see README "Running the stack without Docker".
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ACTIVITY_CHANNEL=polsia:activity
CELERY_TASK_TIME_LIMIT=900
CELERY_SOFT_TIME_LIMIT=840
CELERY_MAX_TASKS_PER_CHILD=50
# redis-py transport bounds (SV-W4-05, wave 5): the publish/subscribe client fails in <=1 s when
# Redis is gone instead of stalling inside redis-py's default retry ladder.  Both are real Settings
# fields now; before wave 5 a value here was silently discarded (`getattr` over a name that was
# not a field).  Read at import time, so a change needs a restart.
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# advertised — not implemented in this repository (the worker command sets --concurrency itself;
# no code path reads this setting)
CELERY_WORKER_CONCURRENCY=4

# ── activity websocket (SV-W4-05, wave 4: these were getattr-only names) ──────
# Ticket lifetime, per-client and per-install socket caps, the heartbeat interval, and (F-03b,
# wave 5) the per-operator MINT bound.  Every cap is enforced at handshake; the refusal is
# delivered by accepting the handshake and closing it as the FIRST frame (SV-W4-12, wave 5), so a
# browser's onclose really sees 1008 (credential/policy) or 1013 (a socket cap) — a pre-accept
# close is an HTTP 403 a browser cannot read, which is what the wave-4 build did.
WS_TICKET_TTL_SECONDS=30
WS_MAX_SOCKETS_PER_CLIENT=4
WS_MAX_SOCKETS_PER_OPERATOR=32
WS_HEARTBEAT_SECONDS=20.0
# F-03b (wave 5): at most WS_TICKET_MINT_LIMIT tickets per operator per
# WS_TICKET_MINT_WINDOW_SECONDS; a mint over either bound is 429 E_RATE_LIMITED on
# POST /api/v1/ws/ticket, and a mint while the operator is already at the socket cap is the same
# 429 (a ticket that could not connect is never handed out).
WS_TICKET_MINT_LIMIT=30
WS_TICKET_MINT_WINDOW_SECONDS=60.0

# ── cycles ────────────────────────────────────────────────────────────────────
MORNING_CYCLE_HOUR=6
EVENING_CYCLE_HOUR=20
COMPANY_TIMEZONE=UTC

# ── task queue discipline ─────────────────────────────────────────────────────
TASK_CLAIM_LEASE_SECONDS=900
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=20
ACTIVITY_RETENTION_DAYS=90
ACTIVITY_BULK_FLUSH=200
# How long a computed company context may be reused (SV-W4-05: the setting did not exist, so this
# value was inert).  Deliberately short — the agent prompt is built from the cached context.
COMPANY_CONTEXT_TTL_SECONDS=30.0

# ── activity event bus ────────────────────────────────────────────────────────
# The publish breaker's window: after a failed Redis publish, further events are SKIPPED (and
# counted — see `events.publish_stats()`) for this long instead of each one stalling out the
# redis-py retry ladder.  Must be > 0; 0 is rejected because it would disable the breaker.
ACTIVITY_PUBLISH_COOLDOWN_SECONDS=30.0

# ── claude code CLI ───────────────────────────────────────────────────────────
# The agents shell out to `claude -p "..." --output-format json`; no Anthropic API key is used.
# `claude login` on the HOST writes ~/.claude, which docker-compose mounts read-only.
#
# CLAUDE_CLI_PATH — one setting, three contexts, no contradiction (audit L5-08): this file and the
# config default both say `claude` (a PATH lookup, what a dev machine has); the container image
# sets its ENV to `/usr/local/bin/claude` (backend/Dockerfile:25 — the absolute path that
# `npm install -g` creates there).  At runtime the env var wins over the config default
# (claude_cli.cli_path()); a path that does not resolve is the named E_CLI_MISSING refusal —
# never a silent fallback to some other binary.
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_SECONDS=300
CLAUDE_MAX_CONCURRENCY=4
CLAUDE_MAX_ARGV_CHARS=24000
CLAUDE_PROMPT_VIA_STDIN=false
CLAUDE_MAX_TURNS=1
CLAUDE_REPAIR_ATTEMPTS=1
CLAUDE_RESUME_SESSIONS=false

# ALWAYS true in tests and CI: makes agents return a stub with no subprocess.
CLAUDE_CLI_MOCK=false
CLAUDE_CLI_MOCK_RESPONSE={"result": "Mock Claude response for testing"}

# ── sandbox ───────────────────────────────────────────────────────────────────
# SANDBOX_MODE=true prevents every real side effect (post, email, ad change, payment, PR).
# A sandboxed action is recorded as a LABELLED DRAFT, never as a success.
SANDBOX_MODE=true

# ── agent budgets ─────────────────────────────────────────────────────────────
AGENT_RUN_COST_CAP_USD=2.0
AGENT_DAILY_COST_CAP_USD=25.0
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_SECONDS=1.5
# Which backend a dispatch would use when the provider seam cannot answer.  Blank = let
# deepseek_runtime.available() decide (the authoritative signal); a non-CLI token ("deepseek",
# "api", "openai", "anthropic_api", "http") makes the preflight skip the CLI-binary check.
# SV-W4-05 (wave 5): the Settings field did not exist, so only a container env var reached it.
POLSIA_MODEL_BACKEND=

# ── kill switch (fleet dispatch gate) ─────────────────────────────────────────
# POLSIA_KILL_SWITCH — blank = run; "throttle" = agents whose purpose is an external action pause
# (reads continue); "freeze" = ALL dispatch refused.  Consumed by the crew_factory dispatch
# preflight and the policy firewall: kill_grade_from_env() reads this env var first, then the
# settings field of the same name.  Set it and the fleet stops without a redeploy.
POLSIA_KILL_SWITCH=

# ── approvals (D1: owner-authed action tokens) ────────────────────────────────
# The HMAC secret behind `policy_firewall.issue_approval`/`verify_approval`; the approvals API
# signs TTL-bounded tokens for a named action fingerprint with it.  Blank leaves the approvals
# channel unconfigured (no token can verify) — set it before issuing approvals.
APPROVAL_SECRET=

# ── planner ───────────────────────────────────────────────────────────────────
PLANNER_MAX_NODES=12
PLANNER_CONTEXT_TOKEN_BUDGET=12000

# ── chroma (vector memory) ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=polsia_memory

# ── stripe (finance agent + webhook) ──────────────────────────────────────────
# STRIPE_WEBHOOK_SECRET must be set for POST /api/v1/finance/stripe/webhook; without it the
# endpoint refuses the NAMED E_CONFIG (503, with how_to_fix) rather than silently accepting
# unverified events.  (This sentence said 500 until wave 5; the code has answered 503 since the
# canonical status table landed in app/core/errors.py.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe signature replay window in seconds (SV-W4-05: the field did not exist, so this was inert).
# Default 300 = Stripe's own tolerance.  A non-positive value falls back to 300, never "off".
STRIPE_SIGNATURE_TOLERANCE=300

# ── local secret store (generic credentials: GitHub Render SendGrid provider keys) ──
# POLSIA_SECRETS_FILE is the store file; blank = the repo-anchored default
# (backend/data/secrets.json).  An explicit path wins.  SV-W4-05: the Settings field did not
# exist, so only a container env var could reach this precedence.
POLSIA_SECRETS_FILE=

# ── X / Twitter ───────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── email (SendGrid out) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# The support inbox is filled via the owner-authenticated POST /api/v1/support/inbox (R17);
# there is no mail-poll (IMAP) setting.
# SUPPORT_INBOUND_SECRET is the PROVIDER shared secret for the public inbound ingest
# (POST /api/v1/support/inbox/inbound), sent as X-Polsia-Inbound-Secret — never X-API-Key, so an
# email provider never holds the key that opens the whole dashboard.  Blank = the route refuses
# with E_CONFIG 503; a missing/wrong secret is 401 E_AUTH.
SUPPORT_INBOUND_SECRET=

# ── email (SendGrid INBOUND — Twilio SendGrid Inbound Parse, wave 9) ──────────
# SendGrid does not send a JSON body, a provider_message_id, or SUPPORT_INBOUND_SECRET.  It POSTs
# multipart/form-data to POST /api/v1/support/inbox/inbound with EITHER an ECDSA signature
# (X-Twilio-Email-Event-Webhook-Signature + -Timestamp over the RAW bytes) or an OAuth bearer token.
# The route parses the vendor's documented form fields, derives the item's provider id from the
# message's own Message-ID (else a content digest — there is no message_id field), and refuses a
# malformed/unverifiable delivery BY NAME (4xx: a 5xx would make SendGrid retry for days).
#
# SENDGRID_INBOUND_PUBLIC_KEY: create a Parse webhook security policy with "signature": {"enabled":
# true} and copy the returned "signature.public_key" value VERBATIM (base64 DER SPKI, starts
# "MFkw…"; a PEM block also works).  Blank = every signature-signed delivery is refused 401 E_AUTH
# naming this setting.
SENDGRID_INBOUND_PUBLIC_KEY=
# SENDGRID_INBOUND_OAUTH_TOKEN: the bearer value your authorization server issues to SendGrid for
# this webhook.  Verified by constant-time token equality (NOT by asking your authorization server).
# Blank = a bearer-only delivery is refused 401 E_AUTH naming SENDGRID_INBOUND_OAUTH_TOKEN.
SENDGRID_INBOUND_OAUTH_TOKEN=
# Replay window for the signed timestamp, in seconds.  SendGrid documents no tolerance; this is a
# product hardening (the Message-ID dedupe already makes a replay a no-op).  Non-positive = 300.
SENDGRID_INBOUND_SIGNATURE_TOLERANCE_SECONDS=300

# ── code generation (GitHub) ──────────────────────────────────────────────────
GITHUB_TOKEN=

# ── site deploy (Render, wave V25 L3) ─────────────────────────────────────────
# `POST /api/v1/sites/{slug}/deploy` submits a deploy of ONE generated site to the Render service
# named by RENDER_SERVICE_ID (the `srv-…` id: Render dashboard -> the service -> Settings).
# RENDER_API_KEY is the owner's Render API key (Account Settings -> API Keys).  With either
# variable blank the route refuses BY NAME (E_CONFIG, 503) and the /sites page renders NO deploy
# button — there is no fake/degraded deploy.  A dry run (the route's DEFAULT) needs the same two
# values but sends nothing and writes nothing: it returns the exact planned call with the key
# masked.  Neither value is ever logged, returned in full, or written into a site's meta.json.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ── ads ───────────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
# advertised — not implemented in this repository (the other four GOOGLE_ADS_* settings are read;
# this one has no code path)
# RESERVED — KEPT under the 2026-10-13 owner decision (D14; our google_ads channel exists): the
# OAuth client secret of a Google Ads API client this deployment does not ship (the other four
# GOOGLE_ADS_* settings are name-checked by app/agents/integrations.py:182-187, which then
# refuses by name).
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# ── channel credentials (LinkedIn / Meta / TikTok / YouTube publishing, optional) ─
# Publishing adapters (app/agents/integrations.py) read these through Settings; blank =
# the channel is unconfigured and posting refuses BY NAME with the missing names listed.
# TikTok needs the Content Posting API's video.publish scope; YouTube needs the Data API's
# youtube.upload scope (videos.insert). Both post media only: their adapter requires image_url.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
# META_PAGE_ACCESS_TOKEN=
# META_FACEBOOK_PAGE_ID=
# META_INSTAGRAM_USER_ID=
# TIKTOK_ACCESS_TOKEN=
# YOUTUBE_ACCESS_TOKEN=

# ── deepseek (the agent runtime's model provider) ─────────────────────────────
# The key can also be entered in the dashboard (Settings → AI model (DeepSeek)); a key
# saved there is stored at DEEPSEEK_KEY_FILE and WINS over DEEPSEEK_API_KEY below.
# Neither value is ever logged or returned by the API — /config/deepseek-key answers
# with a masked status only, and /deepseek-key/verify makes a real (zero-token-cost)
# GET https://api.deepseek.com/models call and reports its genuine result.
DEEPSEEK_API_KEY=
# Where a key saved in the UI persists: relative to the backend working directory
# (backend/data/… locally, /app/data/… in the image).
DEEPSEEK_KEY_FILE=data/deepseek_api_key.json
# Client runtime knobs (fields in config.py): base URL and model of the OpenAI-compatible
# DeepSeek endpoint, reasoning effort ("none" = plain answers), and the per-call timeout.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_TIMEOUT_SECONDS=300
# Per-call output bound (SV-W4-07, wave 4): the vendor documents 1..393216, default 8K without
# thinking / 64K with thinking / 128K at reasoning effort "max".  The shipped 8,192 is a bound,
# not a ceiling — raise it deliberately.
DEEPSEEK_MAX_TOKENS=8192
# How many provider calls ONE logical run may make in the tool loop (SV-W4-05, wave 5).  Clamped
# to 1..12 by the runtime; 0 would refuse every run that needs a tool.
DEEPSEEK_TOOL_LOOP_MAX_ITERATIONS=4

# ── phone link (read-only) ────────────────────────────────────────────────────
# Host root of the Windows Phone Link store, bind-mounted READ-ONLY at /phone-link:ro into
# backend + celery_worker (docker-compose.yml; wave V16).  Blank = the built-in default, the
# measured per-machine path
#   %LOCALAPPDATA%/Packages/Microsoft.YourPhone_8wekyb3d8bbwe/LocalCache/Indexed/<GUID>/System/Database
# (set it explicitly to relocate; the store root must contain phone.db / calling.db / contacts.db).
# An absent or unmounted store makes the phone routes refuse BY NAME (E_PHONE_UNAVAILABLE, 503) —
# never fabricated data.  Read-only: nothing writes to the store; sending is out of scope.
PHONE_LINK_DB_DIR=

# ── agent code workspace (wave V24, L2) ──────────────────────────────────────
# The root the `code_write` / `code_read` / `code_list` registry tools work inside (the
# code_generation agent's text-file surface).  Relative to the backend working directory
# (backend/data/workspace locally, /app/data/workspace in the image — the same rule as
# DEEPSEEK_KEY_FILE); an absolute path is used as given.  Created on first use.  Every path is
# resolved and must stay inside this root: absolute paths, `..` and symlink escapes are refused
# BY NAME, text only, <= 256 KiB per file.  The backend image's WORKDIR is /app, so the default
# resolves to /app/data/workspace — the same persistent volume as the DeepSeek key store (no
# separate compose mount needed).
CODE_WORKSPACE_DIR=data/workspace

# ── task image attachments (wave V25, L1: vision input) ──────────────────────
# Where an uploaded task image lives: <dir>/task-<id>/<uuid>.<ext>.  Relative paths resolve
# against the backend working directory (backend/data/attachments locally, /app/data/attachments
# in the image — the same rule as DEEPSEEK_KEY_FILE and CODE_WORKSPACE_DIR); an absolute path is
# used as given.  Created on the first upload; an unwritable root is a NAMED E_CONFIG refusal.
# Caps (enforced by the service AND re-checked by the DeepSeek runtime): PNG/JPEG/WebP only,
# decided by MAGIC BYTES (not the extension), <= 5 MB per image, <= 4 images per task and
# <= 8 MB of image bytes per task in total (the runtime's per-request vision budget).
ATTACHMENTS_DIR=data/attachments

# ── frontend (browser bundle: inlined at BUILD time, not read at runtime) ─────
# Names + safe defaults only — docker-compose passes these as NEXT_PUBLIC_* build args
# (frontend/Dockerfile ARGs; docker-compose.yml).  Blank is the documented deployment
# default: the REST base stays same-origin and the live-feed socket derives from the
# serving origin (frontend/src/hooks/useActivityFeed.ts); the API key keeps compose's
# own default.  Everything here is embedded in the browser bundle — NEVER a secret.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_WS_URL=
