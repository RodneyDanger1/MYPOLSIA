# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
junit.xml
coverage.xml
.coverage

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
.eslintcache

# ── Local state / data ────────────────────────────────────────────────────────
# The vector store is rebuilt from the DB; it is state, not source.
chroma_data/
*.sqlite
*.sqlite3
*.db
# The e2e fixture writer's repo-relative default (e2e/_helpers.ts → .e2e-lab.sqlite); already matched
# by `*.sqlite` above, named here so the intent is discoverable. Runtime state, never source: it is
# the docker-free lab backend's DB, recreated by a local run (E2E_SQLITE points at it).
.e2e-lab.sqlite

# ── Secrets ───────────────────────────────────────────────────────────────────
# .env holds real API keys (Stripe, Twitter, SendGrid, Tavily, Ads). Only
# .env.example is tracked; a committed .env leaks every integration at once.
.env
.env.local
.env.*.local

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Playwright ───────────────────────────────────────────────────────────────
# Failure artifacts (screenshots, traces, error contexts) and the HTML report are OUTPUT of a run,
# not source: regenerated every time, and a trace bundle is megabytes of binary.
e2e/test-results/
e2e/playwright-report/

# ── Tooling temp files ────────────────────────────────────────────────────────
# A lane's harness left `backend/tests/unit/celery/.hermes-tmp.6tLhJe` untracked (A2 R15 /
# A-H9) before it was deleted; it was never tracked and nothing stopped a future run from
# leaving one committable. Pinned to that directory on purpose: a bare `.hermes-tmp.*` would
# hide any same-named file anywhere in the tree, not just this harness's scratch file.
backend/tests/unit/celery/.hermes-tmp.*

# ── DeepSeek key store ────────────────────────────────────────────────────────
# The owner's DeepSeek API key persists here when it is saved from the dashboard
# (app/services/secret_store.py; the write-temp sibling ends in `.tmp`). Runtime state,
# never source: a committed key file hands the key to everyone with repo access.
backend/data/deepseek_api_key.json
backend/data/deepseek_api_key.json.*.tmp
# The D7 Windows fallback store (app/core/chroma_client.resolve_persist_dir) is runtime state too.
backend/data/chroma/
# The V10 data-wipe consumed-token marker (app/api/v1/data.py `_CONSUMED_TOKENS_PATH`) —
# runtime state as well: a committed marker would leak the wipe history and could burn a
# future owner's confirm token as "already used".
backend/data/data_wipe_consumed.json

# run-suite.sh writes one run log per invocation (e2e/run-<label>.txt) — runtime artifact.
e2e/run-*.txt

# ── Backups (W10 `make backup`) ───────────────────────────────────────────────
# The pg_dump + volume tars `make backup` writes here are runtime state, never source: one
# committed .sql hands over every table, and the backend_data tar carries the DeepSeek key.
backups/

# ── Wave evidence dirs captured in-repo (A-2 §2): may contain captured headers/log lines with
# real secrets (e.g. wave-v10/stripe-lab/listen.log carries a Stripe webhook signing secret).
# NEVER tracked; keep on disk as evidence, out of history forever.
wave-v10/

# drill leftovers (never commit env copies)
.env.bak
.env.*.bak
