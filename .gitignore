# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
junit.xml
coverage.xml
.coverage

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
.eslintcache

# ── Local state / data ────────────────────────────────────────────────────────
# The vector store is rebuilt from the DB; it is state, not source.
chroma_data/
*.sqlite
*.sqlite3
*.db

# ── Secrets ───────────────────────────────────────────────────────────────────
# .env holds real API keys (Stripe, Twitter, SendGrid, Tavily, Ads). Only
# .env.example is tracked; a committed .env leaks every integration at once.
.env
.env.local
.env.*.local

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Playwright ───────────────────────────────────────────────────────────────
# Failure artifacts (screenshots, traces, error contexts) and the HTML report are OUTPUT of a run,
# not source: regenerated every time, and a trace bundle is megabytes of binary.
e2e/test-results/
e2e/playwright-report/

# ── Tooling temp files ────────────────────────────────────────────────────────
# A lane's harness left `backend/tests/unit/celery/.hermes-tmp.6tLhJe` untracked (A2 R15 /
# A-H9) before it was deleted; it was never tracked and nothing stopped a future run from
# leaving one committable. Pinned to that directory on purpose: a bare `.hermes-tmp.*` would
# hide any same-named file anywhere in the tree, not just this harness's scratch file.
backend/tests/unit/celery/.hermes-tmp.*
